    {
      "parameters": {
        "functionCode": "// Вход: ответ от ноды \"Обращение к ИИ\" приходит как строка JSON в message.content\n// Выход: нормализованный объект с variants[3], meta, original_text, user_id, chat_id, timestamp\n\nconst inputItem = $input.first();\nconst aiResponse = inputItem?.json?.message?.content;\n\nif (typeof aiResponse !== 'string' || aiResponse.trim().length === 0) {\n  throw new Error('Пустой ответ ИИ или неверный формат: message.content отсутствует');\n}\n\n// Извлекаем первую JSON-подстроку на случай, если модель добавила текст вокруг\nconst jsonMatch = aiResponse.match(/\\{[\\s\\S]*\\}/);\nif (!jsonMatch) {\n  throw new Error('JSON не найден в ответе ИИ');\n}\n\nlet parsed;\ntry {\n  parsed = JSON.parse(jsonMatch[0]);\n} catch (e) {\n  throw new Error(`Ошибка парсинга JSON: ${e.message}`);\n}\n\n// Базовая валидация структуры\nif (!parsed || !Array.isArray(parsed.variants) || parsed.variants.length !== 3) {\n  throw new Error('Неверная структура: ожидаются ровно 3 объекта в \"variants\"');\n}\n\n// Нормализация длины и типов\nconst normalizeVariant = (variant, index) => {\n  const rawTitle = typeof variant?.title === 'string' ? variant.title : `Вариант ${index + 1}`;\n  const rawBody = typeof variant?.body === 'string' ? variant.body : '';\n\n  const title = rawTitle.length > 80 ? rawTitle.slice(0, 77) + '...' : rawTitle;\n  const body = rawBody.length > 800 ? rawBody.slice(0, 797) + '...' : rawBody;\n\n  return { title, body };\n};\n\nconst normalizedVariants = parsed.variants.map((v, i) => normalizeVariant(v, i));\n\n// Достаём оригинальные данные пользователя из \"Telegram Trigger\"\nconst tg = $('Telegram Trigger').item?.json?.message;\nconst originalText = tg?.text ?? '';\nconst userId = tg?.from?.id ?? null;\nconst chatId = tg?.chat?.id ?? null;\n\nconst result = {\n  variants: normalizedVariants,\n  meta: parsed.meta ?? { model: 'gpt-4o-mini', temperature: 0.7 },\n  original_text: originalText,\n  user_id: userId,\n  chat_id: chatId,\n  timestamp: new Date().toISOString()\n};\n\nreturn [{ json: result }];"
      },
      "id": "05ef068c-61d2-4e13-9598-97289b874da5",
      "name": "Обработка ответа ИИ",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
