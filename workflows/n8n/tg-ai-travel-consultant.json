{
  "name": "TG AI Travel Consultant",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "name": "Telegram Trigger"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Telegram Trigger').item.json.message.text }}",
        "options": {
          "systemMessage": "You are TravelBuddy, a friendly and enthusiastic travel assistant. Your personality is that of a well-traveled expert. Use relevant emojis like ✈️, 🌍, 🏖️, 🗺️.\n\n**Critical Instruction:**\nYou MUST start EVERY new conversation with a friendly greeting that includes a DIFFERENT random fun fact about travel, geography, or cultures. Never repeat the same fact twice in a row. After the fact, immediately ask how you can help.\n\n**Your expertise is strictly limited to:**\n- Suggesting travel destinations based on preferences (beach, mountains, city, budget)\n- Giving short, practical travel tips\n- Answering questions about countries, cities, cultures, and landmarks\n\n**Strict Boundary:**\nFor any request outside this scope (other topics, products, services, or people), you must only reply: \"У меня нет такой информации.\"\n\n**Memory:**\nRemember the user's mentioned preferences (like travel type, budget, discussed locations, interests) and use them to provide personalized, context-aware responses. Reference previous parts of the conversation naturally."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [
        624,
        0
      ],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "tngtech/deepseek-r1t2-chimera:free",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenRouter",
      "typeVersion": 1,
      "position": [
        496,
        208
      ],
      "name": "OpenRouter Chat Model"
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}"
      },
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.3,
      "position": [
        640,
        208
      ],
      "name": "Postgres Chat Memory"
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $('AI Agent').item.json.output }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1184,
        0
      ],
      "name": "Send a text message"
    },
    {
      "parameters": {
        "operation": "sendAnimation",
        "chatId": "={{ $json.message.chat.id }}",
        "file": "https://steamuserimages-a.akamaihd.net/ugc/491275097972975305/040E5F9855F77B46FAC101350E8C61CF4CB427FA/?imw=512&amp;imh=215&amp;ima=fit&amp;impolicy=Letterbox&amp;imcolor=%23000000&amp;letterbox=true",
        "additionalFields": {}
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        208,
        0
      ],
      "name": "Send an animated file"
    },
    {
      "parameters": {
        "operation": "deleteMessage",
        "chatId": "={{ $('Telegram Trigger').item.json.message.from.id }}",
        "messageId": "={{ $('Send an animated file').item.json.result.message_id }}"
      },
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        976,
        0
      ],
      "name": "Delete a chat message"
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Send an animated file",
